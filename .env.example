# Copy this file to ~/.thumbnail-guru/.env and fill in your keys.
# The `tg onboard` wizard does this for you automatically.

# Required — Google Gemini API key (for Nano Banana Pro image generation)
# Get one free at https://aistudio.google.com
GEMINI_API_KEY=AIza-paste-your-key-here

# Optional — YouTube Data API v3 key
# Enables competitor channel validation + auto-fetch of reference thumbnails
# Get one free at https://console.cloud.google.com (enable YouTube Data API v3)
YOUTUBE_API_KEY=
